# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Discord Application ID (Client ID)
DISCORD_CLIENT_ID=YOUR_CLIENT_ID_HERE

# Discord Guild ID (Server ID)
DISCORD_GUILD_ID=YOUR_GUILD_ID_HERE

# Discord Channel ID for check-in notifications
DISCORD_CHECKIN_CHANNEL_ID=YOUR_CHECKIN_CHANNEL_ID_HERE

# ── Gang Systems (Delivery / Treasury / Leave) ──
# (สามารถตั้งค่าใน Admin Panel บนหน้าเว็บได้ หรือใส่ในนี้)
DISCORD_DELIVERY_WEBHOOK=
DISCORD_DELIVERY_CHANNEL_ID=

DISCORD_TREASURY_WEBHOOK=
DISCORD_TREASURY_CHANNEL_ID=

DISCORD_LEAVE_WEBHOOK=
DISCORD_LEAVE_CHANNEL_ID=

# Server Port
PORT=3000

# Website URL (for CORS)
WEBSITE_URL=http://localhost:3000
